PORT=3066
XY_ADMIN_SECRET=
XY_JWT_SECRET=
XY_DB_DRIVER=sqlite
XY_INSTALLED=true
XY_DATABASE_URL=file:./xianyu_admin.db

# ---------- 矩阵管理系统(matrix-tentans)同步 ----------
# matrix-tentans 的公网地址(开发环境用 localhost,生产环境用域名)
MATRIX_GATEWAY_URL=http://localhost:3002
# 从 matrix-tentans「API 密钥」页面生成的站点级密钥(32 hex,无 vab_sk_ 前缀)
# 首次部署时请在 matrix-tentans 后台「API 密钥」页面生成并复制到这里
MATRIX_API_KEY=

# ---------- xian18-shop 同步(闲鱼引流 → 站内发卡) ----------
# xian18-shop 的公网地址(开发环境用 localhost,生产环境用域名)
XIAN18_SHOP_URL=http://localhost:3300
# xian18-shop 的 SEED_RECEIVE_TOKEN(与 affiliate-ai-hub 推送共用,在 xian18-shop .env 中配置)
# 首次部署时请复制 xian18-shop .env 中的 SEED_RECEIVE_TOKEN 值到这里
XIAN18_SHOP_TOKEN=
